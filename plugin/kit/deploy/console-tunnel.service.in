# systemd USER unit for one project's console tunnel. Rendered by deploy/install.sh.
# It reads its OWN config file, ~/.cloudflared/config-<tunnel>.yml, and never the
# default config.yml, so another tunnel on this machine cannot be taken down by it.
# That file exists only once you have created the tunnel (`cloudflared tunnel
# create`, then `onboard.py tunnel`); until then this unit fails to start.
[Unit]
Description=Cloudflare tunnel for the @NAME@ owner console
# 1.62 (audit A4): ordered after the console, but not bound to it. `Requires=` stopped the tunnel whenever
# the console stopped and did not bring it back, and it named the per-project unit that one-server mode
# stops. Unbound, the tunnel answers 502 while the console is down and works again when it is back.
After=network-online.target @NAME@-console.service overture-console.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=@CLOUDFLARED@ tunnel --no-autoupdate --config %h/.cloudflared/config-@TUNNEL@.yml run
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
